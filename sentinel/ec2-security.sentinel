
# Read the proposed Terraform infrastructure
import "tfplan/v2" as tfplan

# AWS instance types approved by our organisation
approved_types = ["t3.micro", "t3.small"]

# Find EC2 instances being created or updated
ec2_instances = filter tfplan.resource_changes as _, rc {
    rc.type is "aws_instance" and
    rc.mode is "managed" and
    (rc.change.actions contains "create" or
     rc.change.actions contains "update")
}

# Reject EC2 instances with unapproved sizes
main = rule {
    all ec2_instances as _, instance {
        instance.change.after.instance_type in approved_types
    }
}
