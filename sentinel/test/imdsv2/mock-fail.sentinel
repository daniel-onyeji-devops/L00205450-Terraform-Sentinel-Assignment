
# Simulated EC2 instance that permits IMDSv1
resource_changes = {
    "aws_instance.insecure_server": {
        "type": "aws_instance",
        "mode": "managed",
        "change": {
            "actions": ["create"],
            "after": {
                "instance_type": "t3.micro",
                "metadata_options": [
                    {
                        "http_tokens": "optional",
                    },
                ],
            },
        },
    },
}
